---
import PianoVertical3D from "../../assets/svg/PianoVertical3D.svg";
---

<div class="about_me">
  <h2 class="text_right">Hello!<br />I’m Dylan</h2>
  <h2 class="text_right">
    I’m a pianist that loves japanese and videogame music
  </h2>
  <h2 class="text_right">
    I want to share my piano journey with you in this blog
  </h2>
  <PianoVertical3D id="piano_vertical_3d" preserveAspectRatio="none" />
</div>

<style>
  .about_me {
    width: 100%;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: start;
    align-items: start;
    position: relative;
    overflow-x: hidden;
  }

  #piano_vertical_3d {
    width: 60%;
    height: 100dvh;
    position: absolute;
    inset: 0;
    z-index: 0;
    transform: translateX(30%);
  }

  .text_right {
    font-size: 8rem;
    font-weight: bold;
    max-width: 65%;
    color: white;
    z-index: 1;
    text-align: end;
    text-wrap: balance;
    align-self: end;
  }
</style>
