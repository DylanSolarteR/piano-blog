---
import PianoVertical3D from "../../assets/svg/PianoVertical3D.svg";
---

<div class="about_me">
  <div id="abme_text_container">
    <h2 class="text_right_about_me">Hello!<br />I’m Dylan</h2>
    <h2 class="text_right_about_me">
      I’m a pianist that loves japanese and videogame music
    </h2>
    <h2 class="text_right_about_me">
      I want to share my piano journey with you in this blog
    </h2>
  </div>
  <div id="svg-wrapper">
    <PianoVertical3D id="piano_vertical_3d" preserveAspectRatio="none" />
  </div>
</div>

<style>
  .about_me {
    margin-top: 20rem;
    width: 100%;
    min-height: 100dvh;
    display: flex;
    justify-content: start;
    align-items: start;
    position: relative;
  }

  .about_me::-webkit-scrollbar {
    display: none;
  }

  #abme_text_container {
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: start;
    align-items: end;
    z-index: 1;
    padding: clamp(4rem, 5vw, 6rem) 0;
    gap: 70rem;
  }

  #svg-wrapper {
    max-width: 100dvw;
    width: 100%;
    height: 100%;
    position: fixed;
    inset: 0;
    z-index: 10;
  }

  #piano_vertical_3d {
    width: 20%;
    height: 100%;
    scale: 5;
    transform: translateX(-200%);
  }

  .text_right_about_me {
    font-size: clamp(2rem, 5vw, 6rem);
    font-weight: bold;
    color: white;
    z-index: 1;
    text-align: end;
    text-wrap: balance;
    margin-left: 40%;
    padding-right: clamp(2rem, 5vw, 5rem);
  }

  .text_right_about_me:nth-of-type(2n) {
    margin-left: 0%;
    align-self: start;
    text-align: start;
    margin-right: 40%;
    padding-left: clamp(2rem, 5vw, 5rem);
  }
</style>
