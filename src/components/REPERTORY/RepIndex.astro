---
import ArrowSVG from "../../assets/svg/vectorarrow.svg";

import PianoWithHands from "../../assets/svg/Piano_with_hands.svg";
---

<div class="repertory">
  <div id="repertory_text">
    <h2 class="text_right">Please, listen to the pieces i’ve learned.</h2>
    <a class="hipervinculo_repertorio a-link"
      ><span>Repertory</span><ArrowSVG
        width={50}
        height={50}
        class="arrow_right"
      />
    </a>
  </div>
  <div id="rep_svg_container">
    <PianoWithHands id="piano_with_hands" preserveAspectRatio="none" />
  </div>
</div>

<style>
  .repertory {
    position: relative;
    max-width: 100dvw;
    width: 100%;
    min-height: 100dvh;
    height: fit-content;
    margin: 40rem 0;
  }

  #repertory_text {
    display: flex;
    flex-direction: column;
    justify-content: start;
    align-items: end;
    gap: 4rem;
    padding: 28rem 0rem;
    position: absolute;
    top: 0;
    right: 0;
    z-index: 1;
  }

  #rep_svg_container {
    width: 100%;
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #piano_with_hands {
    width: 100%;
    translate: -20% 0%;
    scale: 0.5;
  }

  .text_right {
    font-size: 8rem;
    font-weight: bold;
    max-width: 65%;
    color: white;
    z-index: 1;
    text-align: end;
    text-wrap: balance;
    align-self: end;
    padding-right: clamp(2rem, 5vw, 5rem);
  }

  .hipervinculo_repertorio {
    color: white;
    vertical-align: middle;
    font-size: 3rem;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1;
    gap: 1rem;
    margin-right: clamp(2rem, 5vw, 5rem);
  }

  .hipervinculo_repertorio > .arrow_right {
    width: 40px;
    height: 40px;
    translate: 0px 5px;
  }
</style>
