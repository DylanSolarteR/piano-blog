let currentSongId = 0;

function changeSong(newSongId: number) {
  currentSongId = newSongId;
  console.log(
    `Changing to song with ID: ${newSongId} and title: ${mockSongs[newSongId].title}`
  );
}
---

<>
  <div id="no-responsive-next-songs-container">
    <aside id="playing-song">
      <SongCard
        title={mockSongs[currentSongId].title}
        url={mockSongs[currentSongId].url}
        imagePreviewUrl={mockSongs[currentSongId].imagePreviewUrl}
      />
      <div id="song-info">
        <h2>{mockSongs[currentSongId].title}</h2>
        <h3>{mockSongs[currentSongId].author}</h3>
      </div>
    </aside>
    <section id="other-songs-container">
      <div id="other-songs">
        {
          mockSongs
            .filter((song) => song.id !== currentSongId)
            .map((song) => (
              <SongCardPreview
                key={song.id}
                title={song.title}
                author={song.author}
                url={song.url}
                imagePreviewUrl={song.imagePreviewUrl}
                changeSong={() => changeSong(song.id)}
              />
            ))
        }
      </div>
    </section>
  </div>
  <div id="responsive-next-songs-container"></div>
</>

<style>
  #no-responsive-next-songs-container {
    display: flex;
    justify-content: space-evenly;
    align-items: flex-start;
    gap: 3rem;
    padding: 3rem clamp(5rem, 5vw + 1rem, 3rem);
    width: 100%;
    height: 100%;
    min-height: 100dvh;
    color: black;
  }

  #song-info {
    text-align: center;
    margin-top: 1rem;
  }

  #song-info h2 {
    font-size: clamp(1.5rem, 1vw + 1rem, 3rem);
    font-weight: bold;
  }

  #song-info h3 {
    font-size: clamp(0.8rem, 1vw + 0.5rem, 1.25rem);
    font-weight: normal;
  }

  #responsive-next-songs-container {
    display: none;
  }

  #playing-song {
    width: 50%;
    height: 100%;
  }

  #other-songs-container {
    width: 50%;
    height: 90%;
    overflow-y: auto;
    padding: 2rem 1rem;
    scrollbar-gutter: stable both-edges;
    position: relative;
  }

  #other-songs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    row-gap: 2rem;
    column-gap: 1rem;
  }
</style>
