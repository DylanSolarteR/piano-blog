---
import NextSongsPlayer from "./NextSongsPlayer.astro";
---

<main id="next_songs_container">
  <div id="ns-intro-text-container">
    <h2 id="ns-intro-text">Here’s what i’m willing to learn next.</h2>
  </div>
  <div id="songs_player">
    <NextSongsPlayer />
  </div>
  <div id="ns-background">
    <div class="bg-rect"></div>
    <div class="bg-rect"></div>
    <div class="bg-rect"></div>
    <div class="bg-rect"></div>
  </div>
</main>

<style>
  #next_songs_container {
    width: 100%;
    height: 100dvh;
    min-height: 100dvh;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: start;
    align-items: center;
    overflow-x: clip;
  }

  #ns-intro-text-container {
    background-color: #161616;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100dvh;
    min-height: 100dvh;
  }

  #ns-intro-text {
    font-size: clamp(2rem, 4vw + 1rem, 6rem);
    font-weight: bold;
    color: white;
    text-align: center;
    text-wrap: balance;
    z-index: 0;
  }

  #songs_player {
    width: 100%;
    height: 100dvh;
    min-height: 100dvh;
    backdrop-filter: blur(10px);
    z-index: 10;
    background-color: white;
  }

  #ns-background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: start;
    align-items: start;
    z-index: 1;
  }
  #ns-background .bg-rect {
    width: 100%;
    height: 25%;
    background-color: white;
    position: relative;
    z-index: 1;
    scrollbar-width: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  #ns-background .bg-rect::after {
    content: "";
    display: block;
    height: calc(100% / sqrt(2));
    aspect-ratio: 1 / 1;
    transform: translateX(50%) rotate(45deg);
    background-color: white;
  }

  #ns-background .bg-rect::before {
    content: "";
    display: block;
    height: calc(100% / sqrt(2));
    aspect-ratio: 1 / 1;
    transform: translateX(-50%) rotate(45deg);
    background-color: white;
  }

  #ns-background .bg-rect:nth-of-type(2n) {
    transform: translateX(125%);
  }
  #ns-background .bg-rect:nth-of-type(2n + 1) {
    transform: translateX(-125%);
  }
</style>
