---
import { Image } from "astro:assets";
import Play from "@/assets/svg/Play_vector.svg";
import Pause from "@/assets/svg/Pause_vector.svg";

import type { Song } from "./types";

const { title, url, imagePreviewUrl } = Astro.props as Omit<Song, "author">;
---

<div id="SongCard">
  <Image class={"card-image"} src={imagePreviewUrl} alt={title} format="avif" />
  <div id="play-pause-icon">
    <Play id={"play-svg"} />
    <Pause id={"pause-svg"} />
  </div>
</div>

<script>
  const card = document.getElementById("SongCard");
  const playIcon = document.getElementById("play-svg");
  const pauseIcon = document.getElementById("pause-svg");

  card?.addEventListener("click", () => {
    if (playIcon && pauseIcon) {
      if (playIcon.style.display !== "none") {
        playIcon.style.display = "none";
        pauseIcon.style.display = "block";
      } else {
        playIcon.style.display = "block";
        pauseIcon.style.display = "none";
      }
    }
  });
</script>

<style>
  #SongCard {
    width: 100%;
    height: 90%;
    min-height: 90%;
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    cursor: pointer;
    box-shadow: 0 8px 8px 0 rgba(0, 0, 0, 0.2);
  }

  #SongCard .card-image {
    width: 100%;
    height: 100%;
    border-radius: 20px;
    object-fit: cover;
  }

  #play-pause-icon {
    position: absolute;
    padding: 1rem;
    top: 0%;
    left: 0%;
    width: clamp(64px, 5vw + 0.1rem, 128px);
    height: clamp(64px, 5vw + 0.1rem, 128px);
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition: opacity 0.3s ease;
    mix-blend-mode: difference;
  }

  #pause-svg {
    display: none;
  }

  #SongCard:hover #play-pause-icon {
    opacity: 1;
  }
</style>
