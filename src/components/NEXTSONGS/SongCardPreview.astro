---
import { Image } from "astro:assets";
import type { Song } from "./types";

type SongCardPreviewProps = Omit<Song, "url"> & {
  changeSong: () => void;
};

const { title, author, imagePreviewUrl, changeSong } =
  Astro.props as SongCardPreviewProps;
---

<div class="SongCardPreview">
  <div class="SongCard">
    <Image
      class={"card-image"}
      src={imagePreviewUrl}
      alt={title}
      format="avif"
    />
  </div>
  <div class="song-info">
    <h3 class="song-title">{title}</h3>
    <p class="song-author">{author}</p>
  </div>
</div>

<style>
  .SongCardPreview {
    width: 100%;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .SongCard {
    width: 100%;
    height: auto;
    max-width: 300px;
    aspect-ratio: 1/1;
    position: relative;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    pointer-events: none;
  }

  .SongCard .card-image {
    width: 100%;
    height: 100%;
    border-radius: 15px;
    object-fit: cover;
    transition: all 0.3s ease;
    pointer-events: none;
    filter: grayscale(0.85);
  }

  .SongCardPreview:hover .SongCard .card-image {
    transform: scale(1.05);
    filter: grayscale(0);
  }

  .song-info {
    margin-top: 0.5rem;
    text-align: center;
  }

  .song-title {
    font-size: 1rem;
    font-weight: bold;
    margin: 0;
  }

  .song-author {
    font-size: 0.875rem;
    color: #666;
    margin: 0;
  }
</style>
