<style>
  #hero-svg-container {
    --compas-height: 500px;
    position: relative;
    max-width: 70%;
    width: 100%;
    min-height: var(--compas-height);
    display: flex;
    justify-content: center;
  }
  .responsive {
    padding-right: 1.5rem;
    width: 100%;
    height: 100%;
    display: grid;
    margin: 0 auto;
    grid-template-columns: 1fr;
    justify-items: end;
    align-items: end;
  }

  .no-responsive {
    position: absolute;
    bottom: 0;
    right: 0;
    padding-right: 1rem;
    height: 100%;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    justify-content: end;
    justify-items: center;
    align-items: center;
    padding-right: 3rem;
  }

  .no-responsive > div {
    display: flex;
    gap: 20px;
  }

  .title-svg {
    display: inline-block;
    width: auto;
    height: 100px; /* 80 */
  }

  .title-text path {
    --video-duration: 4.3s;
    stroke-dasharray: 3605;
    stroke-dashoffset: 3605;
    stroke: #fff;
    stroke-width: 1;
    fill: white;
    /* fill: transparent; */
    /* animation:
      fillSvg 10s linear forwards,
      fillColor 2s ease-in-out forwards;
    animation-delay: calc(var(--i) * 100ms + var(--video-duration)),
      calc(var(--i) * 150ms + 400ms + var(--video-duration)); */
  }
  @keyframes fillSvg {
    from {
      stroke-dashoffset: 3605;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes fillColor {
    0% {
      fill: transparent;
    }
    80% {
      fill: transparent;
    }
    100% {
      fill: #fff;
    }
  }

  .no-responsive {
    display: none;
  }

  @media (700px <= width < 1024px) {
    .title-svg {
      width: auto;
      height: 130px;
    }
    .responsive {
      padding-right: 3rem;
    }
  }

  @media (1024px <= width < 1280px) {
    .responsive {
      display: none;
    }

    .no-responsive {
      display: grid;
    }

    .title-svg {
      display: inline-block;
      width: auto;
      height: 140px;
    }
  }

  @media (1280px < width < 1540px) {
    .responsive {
      display: none;
    }

    .no-responsive {
      display: grid;
    }

    .title-svg {
      display: inline-block;
      width: auto;
      height: 190px;
    }
  }

  @media (1540px <= width) {
    .responsive {
      display: none;
    }

    .no-responsive {
      display: grid;
    }

    .title-svg {
      display: inline-block;
      width: auto;
      height: 250px;
    }
  }
</style>
