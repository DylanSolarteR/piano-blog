</div>

<style>
  #compas {
    --compas-height: 500px;
    position: relative;
    display: flex;
    width: 95%;
    height: var(--compas-height);
    align-self: end;
    justify-self: start;
    overflow: hidden;
    justify-content: end;
  }
  #back {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  #vertical_line {
    --grosor_linea_vertical: 10px;
    width: var(--grosor_linea_vertical);
    height: 100%;
    background-color: oklch(100% 0 0);
  }
  #horizontal_lines {
    position: absolute;
    top: 0;
    left: var(--grosor_linea_vertical);
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .horizontal_line {
    position: relative;
    width: 100%;
    height: 1px;
    background-color: oklch(100% 0 0);
  }

  #letters {
    height: 100%;
    width: 100%;
    display: flex;
    justify-content: end;
  }

  #ClaveSol {
    position: absolute;
    top: 0;
    left: calc(50% + var(--grosor_linea_vertical) / 2);
    transform: rotate(-10deg) translateY(15%) scale(1.5);
    width: auto;
    height: 0%;
    pointer-events: none;
    padding-left: 1rem;
  }

  @media (600px < width < 1280px) {
    #compas {
      width: 90%;
      overflow: visible;
      padding-top: 0.5rem;
    }
    #ClaveSol {
      height: 100%;
      padding-left: 3rem;
    }
  }

  @media (1280px <= width) {
    #compas {
      overflow: visible;
      padding-top: 0.5rem;
    }

    #ClaveSol {
      height: 100%;
      padding-left: 5rem;
    }
  }
</style>
