---
import Linkedin from "../assets/svg/Linkedin.svg";
import GithubLogo from "../assets/svg/GithubLogo.svg";
import Mail from "../assets/svg/Mail.svg";
---

<footer>
  <div id="front-banner"><p></p></div>
  <div id="back">
    <div id="footer-content">
      <section id="social-icons">
        <a href="https://www.github.com/dylansolarte/">
          <GithubLogo class="icon" style={"filter: brightness(0.37);"} />
        </a>
        <a href="https://www.linkedin.com/@dylansolarte">
          <Linkedin class="icon" style={"filter: brightness(0.50);"} />
        </a>
      </section>
      <section id="footer-text">
        <ul>
          <li>
            <span>© {new Date().getFullYear()} Dylan Solarte.</span>
          </li>
          <li>
            <a href="mailto:dylansolarte@hotmail.com" class="mail-link a-link">
              <Mail id="mail-icon-svg" /> Dylansolarte@hotmail.com
            </a>
          </li>
        </ul>
      </section>
    </div>
  </div>
</footer>

<style>
  footer {
    width: 100%;
    min-height: 20dvh;
  }

  #front-banner {
    width: 100%;
    height: 10dvh;
    background-color: white;
    border-radius: 0 0 20px 20px;
    z-index: 20;
  }

  #back {
    position: relative;
    z-index: 20;
    background-color: black;
    height: 30dvh;
    clip-path: inset(0);
  }

  #footer-content {
    width: 100%;
    display: flex;
    height: 30dvh;
    flex-direction: column;
    justify-content: center;
    align-items: start;
    gap: 1rem;
    position: fixed;
    bottom: 0;
    left: 0;
    padding: 2rem 2rem 1rem;
  }

  #social-icons {
    width: 100%;
    display: flex;
    justify-content: start;
    align-items: start;
    gap: 1rem;
  }

  #footer-text {
    width: 100%;
    color: white;
    font-size: clamp(1.2rem, 1.5vw + 0.5rem, 3rem);
  }

  .icon {
    width: clamp(48px, 6vw, 64px);
    height: clamp(48px, 6vw, 64px);
    transition: all 0.2s ease-in-out;
  }
  .icon:hover {
    transform: scale(1.05);
    filter: brightness(1) !important;
  }

  .mail-link {
    display: flex;
    justify-content: start;
    align-items: center;
    gap: 0.7rem;
    color: white;
    text-decoration: none;
  }

  #mail-icon-svg {
    width: clamp(17px, 2vw, 27px);
    height: clamp(12px, 2vw, 22px);
    transition: all 0.2s ease-in-out;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    justify-content: start;
    align-items: start;
    gap: 0rem;
  }

  @media (600px <= width) {
    #footer-content {
      padding: 6rem 4rem;
    }

    #social-icons {
      gap: 2rem;
    }

    ul {
      flex-direction: row;
      gap: 2rem;
    }
  }
</style>
