---
import Linkedin from "../assets/svg/Linkedin.svg";
import GithubLogo from "../assets/svg/GithubLogo.svg";
import Mail from "../assets/svg/Mail.svg";
---

<footer>
  <div id="front-banner"><p></p></div>
  <div id="back">
    <div id="footer-content">
      <section id="social-icons">
        <a href="https://www.github.com/dylansolarte/">
          <GithubLogo class="icon" style={"filter: brightness(0.37);"} />
        </a>
        <a href="https://www.linkedin.com/@dylansolarte">
          <Linkedin class="icon" style={"filter: brightness(0.50);"} />
        </a>
      </section>
      <section id="footer-text">
        <ul>
          <li>
            <span>© {new Date().getFullYear()} Dylan Solarte.</span>
          </li>
          <li>
            <a href="mailto:dylansolarte@hotmail.com" class="mail-link a-link">
              <Mail /> Dylansolarte@hotmail.com
            </a>
          </li>
        </ul>
      </section>
    </div>
  </div>
</footer>

<style>
  footer {
    width: 100%;
    min-height: 20vh;
  }

  #front-banner {
    width: 100%;
    height: 10vh;
    background-color: white;
    border-radius: 0 0 20px 20px;
    z-index: 20;
  }

  #back {
    position: relative;
    z-index: 20;
    background-color: black;
    height: 30vh;
    clip-path: inset(0);
  }

  #footer-content {
    width: 100%;
    display: flex;
    height: 30vh;
    flex-direction: column;
    justify-content: center;
    align-items: start;
    gap: 2rem;
    position: fixed;
    bottom: 0;
    left: 0;
    padding: 6rem 4rem;
  }

  #social-icons {
    width: 100%;
    display: flex;
    justify-content: start;
    align-items: start;
    gap: 2rem;
  }
  #social-icons img {
    width: 32px;
    height: 32px;
    cursor: pointer;
  }

  #social-icons img:hover {
    transform: scale(1.2);
  }

  #footer-text {
    width: 100%;
    color: white;
    font-size: 2rem;
  }

  .icon {
    width: 64px;
    height: 64px;
    transition: all 0.2s ease-in-out;
  }
  .icon:hover {
    transform: scale(1.05);
    filter: brightness(1) !important;
  }

  .mail-link {
    display: flex;
    justify-content: start;
    align-items: center;
    gap: 0.7rem;
    color: white;
    text-decoration: none;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    justify-content: start;
    align-items: start;
    gap: 2rem;
  }
</style>
