---
import Layout from "@/layouts/Layout.astro";
import HERO from "@/components/HERO/HERO.astro";
import AboutMe from "@/components/ABOUTME/Aboutme.astro";
import RepIndex from "@/components/REPERTORY/RepIndex.astro";
import Nextsongs from "@/components/NEXTSONGS/Nextsongs.astro";
import Footer from "@/components/Footer.astro";
---

<Layout>
  <main id="main-container">
    <HERO />
    <div id="light-beam"></div>
    <section id="about_me_section">
      <AboutMe />
    </section>
    <section id="repertory_section">
      <RepIndex />
    </section>
    <section>
      <div id="next_songs_section">
        <Nextsongs />
      </div>
    </section>
    <Footer />
  </main>
</Layout>

<script>
  import { clear_gsap_context } from "../scripts/gsap_init";
  import { loadAnimationsIndex } from "../scripts/animationsIndex";
  let wantToInitialize = false;

  document.addEventListener(
    "astro:page-load",
    () => {
      const currentPath = window.location.pathname;
      wantToInitialize = currentPath === "/";
      if (wantToInitialize) {
        loadAnimationsIndex();
      }
    },
    { once: false }
  );

  document.addEventListener("astro:after-swap", () => {
    clear_gsap_context();
  });

  
</script>

<style>
  
  #light-beam {
    position: absolute;
    inset: 0;
    pointer-events: none;
    transform-origin: top center;
    opacity: 0;
  }

  #light-beam::before,
  #light-beam::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  /* Luz blanca fuerte en la parte superior */
  #light-beam::before {
    background:
      radial-gradient(
        circle at 110% -60%,
        rgba(255,255,255,0.5) 0%,
        rgba(255,255,255,0.4) 8%,
        rgba(255,255,255,0.2) 12%,
        rgba(255,255,255,0.05) 45%,
        rgba(0,0,0,0) 70%
      );
    mix-blend-mode: screen;
  }

  #light-beam::after {
    background:
      radial-gradient(
        circle at -10% -40%,
        rgba(255,255,255,0.5) 0%,
        rgba(255,255,255,0.4) 8%,
        rgba(255,255,255,0.2) 12%,
        rgba(255,255,255,0.0) 45%,
        rgba(0,0,0,0) 70%
      );
    mix-blend-mode: screen;
  }

  #main-container {
    position: relative;
    height: 100dvh;
    width: 100dvw;
    display: flex;
    justify-content: start;
    align-items: center;
    flex-direction: column;
    background-color: black;
    z-index: 0;
    color: #fff;
    padding-top: env(safe-area-inset-top);
    padding-bottom: env(safe-area-inset-bottom);
    overflow-x: clip;
  }

  section {
    width: 100%;
    height: fit-content;
    max-width: 100dvw;
  }
  #next_songs_section {
    background-color: #161616;
    width: 100%;
    min-height: 100dvh;
    height: fit-content;
  }

</style>

<style is:global>
  .arrow-circle {
    width: 50px;
    height: 50px;
    border: 2px solid white;
    border-radius: 100%;
    background-color: white;
    position: relative;
  }
  .arrow-circle::after {
    content: "";
    display: block;
    position: absolute;
    width: 26px;
    height: 26px;
    border-left: 5px solid black;
    border-bottom: 5px solid black;
    border-radius: 20%;
    top: 50%;
    left: 50%;
    transform: translate(-40%, -60%);
    visibility: inherit;
  }
  .arrow_left {
    transform: rotate(90deg);
  }
  .arrow_up {
    transform: rotate(180deg);
  }
  .arrow_right {
    transform: rotate(270deg);
  }

  .a-link{
    display: block;
    position: relative;   
  }

  .a-link::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 0.1em;
    background-color: white;
    opacity 1;
    transform: scale(0);
    transform-origin: center;
    transition: opacity 300ms, transform 300ms;
  }

  .a-link:hover::after,
  .a-link:focus::after {
    transform: scale(1);
  }
</style>
