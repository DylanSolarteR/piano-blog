---
import Layout from "../layouts/Layout.astro";

import HERO from "../components/HERO/HERO.astro";
import AboutMe from "../components/ABOUTME/Aboutme.astro";
import RepIndex from "../components/REPERTORY/RepIndex.astro";
import Nextsongs from "../components/NEXTSONGS/Nextsongs.astro";
---

<Layout>
  <main id="main-container">
    <HERO />
    <section>
      <AboutMe />
    </section>
    <section>
      <RepIndex />
    </section>
    <section>
      <Nextsongs />
    </section>
  </main>
</Layout>

<style>
  #main-container {
    height: 100vh;
    width: 100vw;
    display: flex;
    justify-content: start;
    align-items: center;
    flex-direction: column;
    gap: 16rem;
  }

  section {
    width: 100%;
    height: fit-content;
    max-width: 100%;
  }
</style>

<style is:global>
  .arrow-circle {
    width: 50px;
    height: 50px;
    border: 2px solid white;
    border-radius: 100%;
    background-color: white;
    position: relative;
  }
  .arrow-circle::after {
    content: "";
    display: block;
    position: absolute;
    width: 26px;
    height: 26px;
    border-left: 5px solid black;
    border-bottom: 5px solid black;
    border-radius: 20%;
    top: 50%;
    left: 50%;
    transform: translate(-40%, -60%);
    visibility: inherit;
  }
  .arrow_left {
    transform: rotate(90deg);
  }
  .arrow_up {
    transform: rotate(180deg);
  }
  .arrow_right {
    transform: rotate(270deg);
  }
</style>
