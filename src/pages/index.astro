---
import Layout from "../layouts/Layout.astro";
import HeroSVG from "../components/HERO/HeroSVG.astro";
import Compas from "../components/HERO/Compas.astro";
import ArrowSVG from "../assets/svg/vectorarrow.svg";
import PianoVertical3D from "../assets/svg/PianoVertical3D.svg";
import PianoWithHands from "../assets/svg/Piano_with_hands.svg";
---

<Layout>
  <main id="main-container">
    <header id="hero">
      <Compas>
        <HeroSVG />
      </Compas>
      <ArrowSVG width={50} height={50} class="arrow_down" />
    </header>
    <section>
      <div class="about_me">
        <h2 class="text_right">Hello!<br />I’m Dylan</h2>
        <h2 class="text_right">
          I’m a pianist that loves japanese and videogame music
        </h2>
        <h2 class="text_right">
          I want to share my piano journey with you in this blog
        </h2>
        <PianoVertical3D id="piano_vertical_3d" preserveAspectRatio="none" />
      </div>
    </section>
    <section>
      <div class="repertory">
        <h2 class="text_right">Please, listen to the pieces i’ve learned.</h2>
        <a class="hipervinculo_repertorio"
          ><span>Repertory</span><ArrowSVG
            width={50}
            height={50}
            class="arrow_right"
          />
        </a>
        <PianoWithHands id="piano_with_hands" preserveAspectRatio="none" />
      </div>
    </section>
  </main>
</Layout>

<style>
  #main-container {
    height: 100vh;
    width: 100vw;
    display: flex;
    justify-content: start;
    align-items: center;
    flex-direction: column;
    gap: 8rem;
  }

  #hero {
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
    align-items: center;
    gap: 4rem;
  }

  section {
    margin: 0 6.125rem;
    width: 100%;
    height: fit-content;
  }

  .about_me {
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: start;
    align-items: start;
    position: relative;
  }

  .about_me::after {
    content: "";
    display: block;
    padding-top: calc(1440 / 2070 * 100%);
  }

  #piano_vertical_3d {
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .text_right {
    font-size: 8rem;
    font-weight: bold;
    max-width: 65%;
    color: white;
    z-index: 1;
    text-align: end;
    text-wrap: balance;
    align-self: end;
  }

  .repertory {
    max-width: 100vw;
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: start;
    align-items: end;
    position: relative;
    padding-top: 40rem;
    gap: 4rem;
  }
  .repertory::after {
    content: "";
    display: block;
    padding-top: calc(1440 / 2366 * 100%);
  }

  #piano_with_hands {
    width: 140%;
    height: 100%;
    position: absolute;
    inset: 0;
    z-index: 0;
    translate: -20%;
    rotate: -5deg;
    scale: 0.9;
  }

  .hipervinculo_repertorio {
    color: white;
    vertical-align: middle;
    font-size: 3rem;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1;
    gap: 1rem;
  }

  .hipervinculo_repertorio > .arrow_right {
    width: 40px;
    height: 40px;
    translate: 0px 5px;
  }

  .hipervinculo_repertorio:hover {
    text-decoration: underline;
  }
</style>

<style is:global>
  .arrow-circle {
    width: 50px;
    height: 50px;
    border: 2px solid white;
    border-radius: 100%;
    background-color: white;
    position: relative;
  }
  .arrow-circle::after {
    content: "";
    display: block;
    position: absolute;
    width: 26px;
    height: 26px;
    border-left: 5px solid black;
    border-bottom: 5px solid black;
    border-radius: 20%;
    top: 50%;
    left: 50%;
    transform: translate(-40%, -60%);
    visibility: inherit;
  }
  .arrow_left {
    transform: rotate(90deg);
  }
  .arrow_up {
    transform: rotate(180deg);
  }
  .arrow_right {
    transform: rotate(270deg);
  }
</style>
