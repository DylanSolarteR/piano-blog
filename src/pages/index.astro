---
import Layout from "../layouts/Layout.astro";
import HeroSVG from "../components/HERO/HeroSVG.astro";
import Compas from "../components/HERO/Compas.astro";
---

<Layout>
  <main id="main-container">
    <header id="hero">
      <Compas>
        <HeroSVG />
      </Compas>
    </header>
  </main>
</Layout>

<style>
  #main-container {
    height: 100vh;
    width: 100vw;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  #hero {
    width: 100%;
    height: 100%;
    padding-top: 8rem;
    display: flex;
    flex-direction: column;
    justify-content: start;
    align-items: center;
  }
</style>
