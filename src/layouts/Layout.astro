---
import { ClientRouter } from "astro:transitions";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="initial-scale=1, width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Dylan's Piano Blog</title>
    <meta name="title" content="Dylan's Piano Blog" />
    <meta
      name="description"
      content="A blog about my piano progress and performances."
    />

    <ClientRouter />
  </head>
  <body id="body">
    <div id="video-container">
      <video
        id="intro-video"
        src="/Intro.mp4"
        autoplay
        muted
        playsinline
        preload="auto"></video>
    </div>
    <slot />

    <script is:inline>
      window.addEventListener("DOMContentLoaded", () => {
        const video = document.getElementById("intro-video");
        const container = document.getElementById("video-container");

        const endIntro = () => {
          container.classList.add("is-ending");
          setTimeout(() => {
            container.style.display = "none";
            document.body.style.overflow = "auto";
            window.dispatchEvent(new Event("intro-video-ended"));
          }, 320);
        };

        if (!video || !container) {
          endIntro();
          return;
        }

        document.body.style.overflow = "hidden";

        const MAX_START_WAIT_MS = 2500; // fallback si NO hay señal de arranque
        const MAX_TOTAL_INTRO_MS = 9000; // failsafe total

        let started = false;

        const cleanup = () => {
          video.removeEventListener("play", onAnyStart);
          video.removeEventListener("playing", onAnyStart);
          video.removeEventListener("ended", onEnded);
          video.removeEventListener("error", onError);
        };

        const cancelStartTimeout = () => {
          if (startTimeoutId) clearTimeout(startTimeoutId);
          startTimeoutId = null;
        };

        const markStarted = () => {
          if (started) return;
          started = true;
          cancelStartTimeout();

          // Tu cambio de fondo a negro a los 3.35s (sin timeupdate)
          const t = 3.35;
          const check = () => {
            if (video.currentTime >= t)
              container.style.backgroundColor = "black";
            else requestAnimationFrame(check);
          };
          requestAnimationFrame(check);
        };

        const onAnyStart = () => {
          // "play" suele disparar antes que "playing"
          markStarted();
        };

        const onEnded = () => {
          cleanup();
          endIntro();
        };

        const onError = () => {
          cleanup();
          endIntro();
        };

        video.addEventListener("play", onAnyStart);
        video.addEventListener("playing", onAnyStart);
        video.addEventListener("ended", onEnded, { once: true });
        video.addEventListener("error", onError, { once: true });

        // 1) Timeout: si no hay ninguna señal de arranque en X ms → fallback
        let startTimeoutId = setTimeout(() => {
          if (!started) {
            cleanup();
            try {
              video.pause();
            } catch {}
            endIntro();
          }
        }, MAX_START_WAIT_MS);

        // 2) Failsafe total
        setTimeout(() => {
          cleanup();
          try {
            video.pause();
          } catch {}
          endIntro();
        }, MAX_TOTAL_INTRO_MS);

        // 3) Intento de play: si resuelve, también lo consideramos "arrancó"
        (async () => {
          try {
            const p = video.play();
            if (p && typeof p.then === "function") await p;

            // Si play() resolvió, casi seguro ya arrancó o está por arrancar.
            // Marcamos started para evitar falsos fallbacks.
            markStarted();
          } catch {
            cleanup();
            endIntro();
          }
        })();
      });
    </script>
    <script src="../scripts/initPlugins.ts"></script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Caudex";
    src: url("/fonts/caudex-v19-latin-regular.woff2") format("woff2");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Caudex";
    src: url("/fonts/caudex-v19-latin-700.woff2") format("woff2");
    font-weight: bold;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Caudex";
    src: url("/fonts/caudex-v19-latin-italic.woff2") format("woff2");
    font-weight: normal;
    font-style: italic;
    font-display: swap;
  }

  @font-face {
    font-family: "Caudex";
    src: url("/fonts/caudex-v19-latin-700italic.woff2") format("woff2");
    font-weight: bold;
    font-style: italic;
    font-display: swap;
  }

  *,
  *::before,
  *::after {
    padding: 0;
    margin: 0;
    box-sizing: inherit;
  }
</style>

<style>
  html,
  body {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    width: 100%;
    height: 100dvh;
    background-color: oklch(0% 0 0);
    padding: 0;

    font-family: "Caudex", sans-serif;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  body::-webkit-scrollbar {
    display: none;
  }

  #video-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100dvh;
    overflow: hidden;
    z-index: 9999;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: white;
    transition:
      background-color 0.2s linear,
      opacity 300ms ease;
    opacity: 1;

    pointer-events: none;
  }

  #video-container.is-ending {
    opacity: 0;
    pointer-events: none;
  }

  #intro-video {
    width: auto;
    height: 100dvh;
  }
</style>
